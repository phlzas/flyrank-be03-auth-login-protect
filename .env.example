# Copy this file to ".env" and fill in real values.
# The .env file itself is git-ignored and must never be committed.

# Port the API listens on
PORT=3000

# Symmetric JWT signing secret. MUST be at least 32 characters.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=replace-me-with-a-random-string-of-at-least-32-characters

# Token metadata (defaults are fine)
JWT_ISSUER=flyrank-auth
JWT_AUDIENCE=flyrank-auth-clients

# Access token lifetime (minutes) and refresh token lifetime (days)
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# SQLite database file (created automatically on first run)
DATABASE=flyrank_auth.db
