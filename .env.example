# Copy this file to ".env" and fill in real values.
# The .env file itself is git-ignored and must never be committed.

# Port the API listens on
PORT=3000

# Symmetric JWT signing secret. MUST be at least 32 characters.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=replace-me-with-a-random-string-of-at-least-32-characters

# Token metadata (defaults are fine)
JWT_ISSUER=flyrank-auth
JWT_AUDIENCE=flyrank-auth-clients

# Access token lifetime (minutes) and refresh token lifetime (days)
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Comma-separated emails that receive the "admin" role (for the 403 demo route).
# Anyone else is a plain "user" and gets 403 on GET /protected/admin.
ADMIN_EMAILS=admin@example.com

# SQLite database file (created automatically on first run)
DATABASE=flyrank_auth.db

# ---- LLM (Week 7 / A17 - "Put an LLM behind your API") ----
# Any OpenAI-compatible provider works. To swap providers, change ONLY these three
# values and nothing else (that is the point of the base-URL trick).
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=replace-with-your-provider-key
LLM_MODEL=your-model-id

# Behaviour knobs (defaults are fine)
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0
LLM_ENABLED=true
LLM_STUB=false
LLM_JSON_MODE=false
